# ==========================================
# CCL Maintenance Portal - Git Ignore Rules
# ==========================================

# 1. Environment Variables & Secrets (CRITICAL)
.env
.env.local
.env.*.local
*.env

# 2. Local Database & Development Data (CRITICAL)
*.sqlite3
*.sqlite3-journal
*.sqlite3-shm
*.sqlite3-wal
db.sqlite3

# 3. User Uploaded Media Files (CRITICAL - e.g. complaint photos)
media/
media/*

# 4. Python Virtual Environments
venv/
env/
.venv/
ENV/
env.bak/
venv.bak/

# 5. Compiled Bytecode & Caches
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/

# 6. Static files collected for production
staticfiles/

# 7. IDE, Editor & OS Artifacts
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
.DS_Store
Thumbs.db
desktop.ini

# 8. Log files
*.log
logs/
