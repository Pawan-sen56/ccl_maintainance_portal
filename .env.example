# ==========================================
# CCL Maintenance Portal - Environment Variables Template
# Copy this file to .env and fill in real production secrets
# ==========================================

# Secret key: generate using `python -c "import secrets; print(secrets.token_urlsafe(50))"`
SECRET_KEY=your-production-secret-key-goes-here

# Set to False in production
DEBUG=False

# Comma-separated list of your domain names or server IPs
ALLOWED_HOSTS=yourdomain.com,ccl-portal.onrender.com,127.0.0.1

# CSRF Trusted Origins (needed for Django forms over HTTPS)
CSRF_TRUSTED_ORIGINS=https://yourdomain.com,https://ccl-portal.onrender.com

# PostgreSQL Database URL for production (e.g. from Render, Supabase, Neon, AWS RDS)
DATABASE_URL=postgresql://username:password@hostname:5432/databasename
